{
  "permissions": {
    "allow": [
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__list_recent_files",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__get_file_permissions",
      "Artifact"
    ],
    "defaultMode": "dontAsk"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /root/.local/bin/graphify ]; then exec /root/.local/bin/graphify hook-guard search; fi"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x /root/.local/bin/graphify ]; then exec /root/.local/bin/graphify hook-guard read; fi"
          }
        ]
      }
    ]
  }
}