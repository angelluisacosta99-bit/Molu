# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Editores
.vscode/
.idea/

# Archivos pesados de audio/video: no se versionan en Git.
# Súbelos a Google Drive y deja el enlace en el README correspondiente
# (ver docencia-espanol/grabaciones/README.md).
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a

# Archivos temporales
*.tmp
*.log

# graphify: archivos intermedios del pipeline y caché local.
# graph.json, GRAPH_REPORT.md y graph.html sí se versionan (son el
# resultado final consultable); esto solo ignora el trabajo en curso.
graphify-out/.graphify_*
graphify-out/cache/

# graphify-out/converted/: sidecars .md que graphify genera solo (de
# .docx/.xlsx/Google Workspace) para poder leerlos — se regeneran solos
# en el próximo `graphify update`, no son contenido original.
graphify-out/converted/

# NOTA: graphify-out/YYYY-MM-DD/ (respaldos con fecha que graphify crea
# antes de sobrescribir el grafo curado cuando las comunidades cambian
# mucho) NO se ignora a propósito — es la única red de seguridad para
# recuperar nombres de comunidad curados por LLM si un rebuild automático
# (el hook post-commit/post-checkout) los degrada a nombres genéricos sin
# que nadie se dé cuenta. Sí se versiona.

# Exportaciones puntuales de graphify (para incrustar en una presentación,
# abrir en Gephi/yEd, etc.): pesan varios MB, no las mantiene al día
# ningún hook, y quedarían obsoletas en el próximo rebuild automático de
# código. Se generan bajo demanda con `graphify export svg|graphml`, no
# se versionan. graphify-out/wiki/ sí se versiona (es texto, ligero, y es
# el resultado final consultable, como graph.json/GRAPH_REPORT.md).
graphify-out/graph.svg
graphify-out/graph.graphml

# Configuración local de Claude Code: overrides personales y, en su caso,
# API keys (ej. GEMINI_API_KEY para graphify). Nunca debe subirse al repo.
.claude/settings.local.json

# Marcadores efímeros de "PR ya revisado" que usa el hook
# check-pr-review.sh (ver CLAUDE.md, Flujo de trabajo para Pull
# Requests). Estado de sesión, no algo que versionar.
.claude/.pr-review-state/
