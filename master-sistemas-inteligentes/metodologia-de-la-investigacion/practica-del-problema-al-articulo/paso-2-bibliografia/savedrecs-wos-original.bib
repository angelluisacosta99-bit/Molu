Title = {Fast QoT estimation method using cascaded artificial neural network for
   real-time path provisioning in IMDD based all-optical networks},
Journal = {OPTICS EXPRESS},
Year = {2024},
Volume = {32},
Number = {2},
Pages = {1176-1187},
Month = {JAN 15},
Abstract = {We propose a fast quality of transmission (QoT) estimation method based
   on cascaded artificial neural networks (ANNs) for intensity modulation
   -direct detection (IMDD) systems. The proposed method can calculate the
   bit error rate of three -span 36 km transmission within 0.7 seconds
   while taking account of the deterministic waveform distortion caused by
   the chromatic dispersion and self -phase modulation (SPM).},
